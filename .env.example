# Public browser configuration. These values are safe to expose only because the
# Supabase database policies in supabase/migrations are enabled.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Server-only configuration. Set these in Vercel; never prefix them with VITE_.
# SUPABASE_SECRET_KEY is the current Supabase secret key (sb_secret_...).
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"
APP_URL="https://your-production-domain.vercel.app"

# Optional comma-separated allowlist for Vercel preview domains and a custom domain.
# Also accepts Vercel's configured deployment URL; never trusts a supplied Host header.
ALLOWED_ORIGINS="https://your-production-domain.vercel.app"
